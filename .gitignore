# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/

# claude code worktrees
/.claude/worktrees/

# next.js
/.next/
/out/
/.source/
next-env.d.ts
*.tsbuildinfo

# CLI package build output
/packages/cli/dist/
/packages/cli/node_modules/

# aptos CLI profiles: dev/CI keys for localnet and testnet. Never committed,
# and mainnet key material never lands here at all -- the Anchor Signer lives in
# cloud KMS and the Upgrade Authority stays offline (aptos-anchoring-proposal.md 4.6).
/.aptos/

# Move build output
/move/*/build/
